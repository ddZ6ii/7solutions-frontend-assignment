{
  "name": "7solutions-frontend-assignment",
  "version": "0.0.0",
  "private": true,
  "description": "7Solutions frontend assignment monorepo: Auto Delete List web app",
  "author": "Denis Dezest",
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run --filter web dev",
    "dev:api": "vp run --filter api dev",
    "build": "vp run -r build",
    "preview": "vp run --filter web preview",
    "format": "vp format",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "test:web": "vp test --project web",
    "test:api": "vp test --project api",
    "coverage": "vp test --coverage"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
