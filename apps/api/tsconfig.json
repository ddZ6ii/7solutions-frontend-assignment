{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    /* Explicit, so "types" still resolves when this config is extended from
       elsewhere: Vercel's build extends it from a temporary folder, where the
       default lookup (node_modules/@types next to the config) finds nothing. */
    "typeRoots": ["./node_modules/@types"],

    /* Node mode: Vercel compiles each file to .js and runs it with Node's
       native ESM loader (no bundler), which needs file extensions on relative
       imports. "nodenext" makes the type check reject imports without one;
       imports are written with .ts, which Vercel rewrites to .js. */
    "module": "nodenext"
  },
  "include": ["src", "vite.config.ts", "vite.live.config.ts"]
}
